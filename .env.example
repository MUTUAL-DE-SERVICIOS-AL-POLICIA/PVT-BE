# Plantilla de las variables de Laravel (runtime).
#
# Cada entorno tiene su propio archivo, creado a partir de esta plantilla:
#   cp .env.example env/.env.prod
#   cp .env.example env/.env.test
#   cp .env.example env/.env.dev
#   cp .env.example env/.env.dev-local
# Esos archivos NO se versionan (tienen secretos) y se montan en runtime como
# /var/www/.env. El compose los toma de ENV_FILE en env/<entorno>.compose.env.
#
# Lo que NO va aca: las variables de orquestacion y build (proyecto, puerto,
# imagen, COMPOSER_FLAGS, MIX_APP, MIX_*, DEBUGBAR_ENABLED). Esas viven en
# env/<entorno>.compose.env.

# --- Aplicación ---
APP_NAME=PVT
# development (desarrollo) o production (produccion).
APP_ENV=production
# true: los errores muestran el detalle tecnico. false en produccion.
APP_DEBUG=false
# Clave de cifrado. Si esta vacia, generarla con: php artisan key:generate --show
APP_KEY=
# Direccion publica del sistema (con puerto si no es 80/443). No cambia las
# URLs de la web: solo se usa en consola y en enlaces que arma el backend.
# En dev cambia segun la maquina: http://<host-interno>:9012 (servidor) o
# http://localhost:9012 (PC), y smoke.sh la usa para saber a donde apuntar.
APP_URL=https://pvt.example.gob.bo
APP_TIMEZONE=America/La_Paz
APP_LOCALE=es

# --- Logs ---
# se lee con docker compose logs -f app
LOG_CHANNEL=stderr
# dev: debug | prod: warning
LOG_LEVEL=warning

# --- Base principal (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres.interno
DB_PORT=5432
DB_DATABASE=now
DB_USERNAME=pvt_user
DB_PASSWORD=

# --- Base de préstamos (SQL Server, opcional) ---
DB_LOAN_HOST=
DB_LOAN_PORT=1433
DB_LOAN_DATABASE=loans
DB_LOAN_USERNAME=
DB_LOAN_PASSWORD=

# --- Documentos (FTP) ---
FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_ROOT="/pvtp/"
FTP_SSL=false
LOCAL_ROOT="/tmp/PVT/"

# --- Caché, sesión y colas (siempre redis: el worker procesa la cola) ---
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
# sin contraseña: el puerto no se publica, solo es alcanzable en la red interna
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=""
REDIS_CLIENT=phpredis
# Cookie de sesion: true solo si el sitio se sirve por HTTPS (si esta en true
# con http, el navegador no manda la cookie y el login falla).
SESSION_SECURE_COOKIE=false

# --- Frontend ---
# MIX_APP, MIX_PVT_URL y MIX_RRHH_URL NO van aca: el frontend se compila al
# construir la imagen y esas variables se pasan como build args desde
# env/<entorno>.compose.env.


# --- Correo ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="PVT"

# --- LDAP (el login requiere HOST, PORT y BASEDN) ---
LDAP_AUTHENTICATION=false
LDAP_HOST=
LDAP_PORT=389
LDAP_SSL=false
LDAP_ADMIN_PREFIX=
LDAP_ADMIN_USERNAME=
LDAP_ADMIN_PASSWORD=
LDAP_ACCOUNT_PREFIX=uid
LDAP_ACCOUNT_SUFFIX="ou=usuarios"
LDAP_BASEDN="dc=example,dc=com"
LDAP_TIMEOUT=6

# --- Servicios externos ---
LIVENESS_URL=
LIVENESS_API_ENDPOINT=/api/v1
LIVENESS_DISTANCE=0.4
# incluir el esquema (http://); el puerto es CLIENT_GATEWAY_PORT del launcher
GATEWAY_URL=
GATEWAY_PORT=
GATEWAY_API_KEY=
# obligatorio: sin él la API móvil rechaza las peticiones (hash bcrypt)
HASH_TOKEN=
JWT_SECRET=
JWT_TTL=300

# --- Pruebas (dejar vacío en producción) ---
TEST_APP=
USER_TEST_DEVICE=
