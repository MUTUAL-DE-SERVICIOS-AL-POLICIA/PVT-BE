# TESTING — igual a produccion pero con la barra del Debugbar.
COMPOSE_PROJECT_NAME=pvt-be-test
COMPOSE_FILE=docker-compose.yml
APP_IMAGE=pvt-app:test
APP_PORT=9014
# --dev: la imagen lleva dependencias de desarrollo (Debugbar).
COMPOSER_FLAGS=--dev
# TODO: test pasara a app_test.scss tras la revision visual. Por ahora prod,
# para que el CSS sea identico al actual.
MIX_APP=prod
MIX_PVT_URL=
MIX_RRHH_URL=
DEBUGBAR_ENABLED=true
ENV_FILE=./env/.env.test
