# PRODUCCION — orquestacion y build. Los secretos van en env/.env.prod.
COMPOSE_PROJECT_NAME=pvt-be-prod
COMPOSE_FILE=docker-compose.yml
APP_IMAGE=pvt-app:prod
APP_PORT=9015
# Imagen sin dependencias de desarrollo: no lleva Debugbar.
COMPOSER_FLAGS=--no-dev
# MIX_APP decide el CSS al compilar. prod = app.scss + purgecss.
MIX_APP=prod
MIX_PVT_URL=
MIX_RRHH_URL=
DEBUGBAR_ENABLED=false
ENV_FILE=./env/.env.prod
