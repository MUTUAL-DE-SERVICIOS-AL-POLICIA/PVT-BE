# No viaja al contexto de build
.git
.gitignore
.gitmodules
.worktrees
laradock
vendor
node_modules

# El frontend se compila en la etapa assets, asi que resources/ SI viaja.
# Lo que no viaja son los compilados: los genera esa etapa (ver Dockerfile).

# Generado en desarrollo
bootstrap/cache/*.php
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
*.log

# Secretos: el .env se monta en runtime
.env

# No hacen falta en runtime y se quedaban viejos dentro de la imagen
docker-compose*.yml
README.md
INSTRUCTIONS.md
UPDATE.md
LICENSE
LICENCE.txt

# Compilados del frontend: los genera la etapa assets, no se copian del host
public/js/app.js
public/js/app.js.map
public/js/datatable.js
public/js/datatable.js.map
public/css/app.css
public/css/app.css.map
public/css/datatable.css
public/css/datatable.css.map
public/css/materialicons.css
public/css/materialicons.css.map
public/css/wkhtml.css
public/css/wkhtml.css.map
public/css/vuetify.css
public/css/vuetify.css.map
public/mix-manifest.json

# Variables de runtime: se montan en runtime, no viajan en el contexto
env/.env.*
